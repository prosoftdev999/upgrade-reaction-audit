  "handlers": {
    "telemetry.audit": {
      "lane": "micro",
      "job_key": "telemetry-audit",
      "coalesce": "replace",
      "actions": [
        {
          "op": "bump_state",
          "key": "count",
          "by": 1
        },
        {
          "op": "set_attr",
          "target": {
            "kind": "controller"
          },
          "name": "state",
          "value": "trace:{task_id}:{payload}:{revision_id}:cap={captured_revision}:live={live_revision}:n={state_count}"
        },
        {
          "op": "queue_async",
          "handler_id": "followup.audit",
          "payload": "follow:{task_id}:{payload}"
        }
      ]
    },
    "bridge.publish": {
      "lane": "user",
      "job_key": "bridge-publish",
      "coalesce": "replace",
      "actions": [
        {
          "op": "bump_state",
          "key": "count",
          "by": 2
        },
        {
          "op": "set_attr",
          "target": {
            "kind": "controller"
          },
          "name": "route",
          "value": "trace:{task_id}:{payload}:{revision_id}:cap={captured_lane}:live={live_lane}:n={state_count}"
        },
        {
          "op": "set_attr",
          "target": {
            "kind": "live_role",
            "role": "bridge-main"
          },
          "name": "status",
          "value": "trace-live:{task_id}:{payload}:{revision_id}"
        }
      ]
    },
