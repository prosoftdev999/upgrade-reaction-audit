          "name": "status",
          "value": "trace-theme:{task_id}:{payload}:cap={captured_revision}:live={live_revision}:n={state_count}"
        },
        {
          "op": "shared_mutate",
          "slot": "theme_bus",
          "values": {
            "lane": "trace-{task_id}-{payload}"
          }
        }
      ]
    },
